[ 
	"Ok, seu pentelho! Fa\xE7a um Spine Transfer (\\ml) pela FunBox e dentro da piscina." 
] 
Margera_tr_goal_gaps14 = 
[ 
	"Aham, agora v\xE1 at\xE9 o QP com um angulo e de um Hip Transfer. (\\ml)" 
