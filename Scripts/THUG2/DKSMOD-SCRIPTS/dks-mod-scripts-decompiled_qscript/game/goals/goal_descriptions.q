[ 
	"Se voce se cansar de aprender, pare um pouco e veja se voce consegue bater o high score." 
] 
Valley_tr_goal_gaps11_camanim01 = 
[ 
	"E ae cara, que bom que tu ta na nossa equipe." 
] 
Valley_tr_goal_gaps11 = 
[ 
	"Saca so, essa parte da parede ta rachada e pronta pra ser quebrada.\\n Voce so precisa dar um Sticker Slap.\\nDe um grind (\\b0) no topo do QP em direcao a parede. Quando estiver perto, pule (\\b3) e de um Sticker Slap (\\b3)." 
] 
Valley_tr_goal_gaps11_success = 
[ 
	"Fique ligado em coisas que dao para quebrar." 
] 
Valley_tr_goal_gaps12 = 
[ 
	"Foda! Aproveita que ta ai dentro e abre a porta. Ta vendo aquele botao vermelho? De um Wallride nele. Para dar um Wallride, va contra a parede em um angulo, de um Ollie (\\b3) e um Wallride (\\b0)." 
] 
Margera_tr_goal_counter5_camanim01 = 
[ 
	"E agora, Wallie. Enquanto voce ta em um Wallride, de um Wallie (\\b3) pra ir mais alto." 
] 
Margera_tr_goal_counter5 = 
[ 
	"Tenta aqui.\\nVa em dire\xE7ao a parede, de um Ollie (\\b3) e um Wallride (\\b0). Ae no fim do Wallride, de um Wallie (\\b3).\\nAe, no fim, de um Grind (\\b0) no trilho l\xE1 em cima." 
] 
