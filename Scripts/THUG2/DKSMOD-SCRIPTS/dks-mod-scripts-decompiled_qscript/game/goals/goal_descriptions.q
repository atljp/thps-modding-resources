[ 
	"Hora de um Acid Drop.\\nAo estilo do Mike V." 
] 
Vallely_tr_goal_gaps22 = 
[ 
	"Ande at\xE9 a borda, de um Ollie, e meta a bomba. (\\ml)" 
] 
Muska_tr_goal_gaps16_camanim01 = 
[ 
	"Agora \xE9 hora do seu primeiro combo.\\nPrimeiro, suba o QP e de um Grind no topo. " 
] 
Muska_tr_goal_gaps16_camanim02 = 
[ 
	"Depois, no fim do QP, pule e de um grind naquele trilho." 
] 
Muska_tr_goal_gaps16 = 
[ 
	"E por ultimo, no fim do trilho, pule e de um grind nesse QP." 
