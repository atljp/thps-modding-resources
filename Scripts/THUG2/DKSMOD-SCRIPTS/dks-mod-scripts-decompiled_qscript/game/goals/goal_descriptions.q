[ 
	"Va at\xE9 esses posteres vazios e fa\xE7a um graffiti neles. Tem cinco lugares como esse no mapa. Ache-os e piche! (\\b0)" 
] 
Muska_tr_goal_gaps28 = 
[ 
	"Ei, precisamos que voce suba la de novo e pinte aquele poster. Apenas se segure na borda e deixe sua marca.(\\b0)" 
] 
Muska_tr_goal_gaps29 = 
[ 
	"Fa\xE7a um Skitch (\\b7) atr\xE1s da empilhadeira por 10 segundos." 
] 
Hawk_tr_goal_gaps27 = 
[ 
	"Pronto pra ir embora, ha? So quero te mostrar uma coisa antes de ir..\\nPegue especial e comece um combo. Depois que voce come\xE7ou o combo, voce pode ativar o controle de \'Focus\' (\\mq)." 
] 
BO_Intro_Text1 = "Cara, que viagem! Burritos de posto e uma van lotada de caras... Nada como uma vanzinha a 150 Km/h..." 
BO_Intro_Text2 = "Pronto pra sair por ai? Comece com esses tro\xE7os que vao nos dar uma porrada de pontos." 
BO_Intro_Text3 = "Venha at\xE9 aqui quando estiver pronto." 
BO_Gap11_Goal_Text = "Desafio da Equipe" 
BO_Gap11_Goal_Description = [ "3 membros da sua equipe devem dar um kickflip em cima de um cara de patins." ] 
BO_Gap11_Goal_Tip = "Inliners podem ser encontrados facilmente no parque municipal." 
BO_Gap4_Goal_Text = "O Grind do Canhao" 
BO_Gap4_Goal_Description = [ "Ache e de um grind num canhao." ] 
BO_Gap4_Goal_Tip = "Ha uma exposi\xE7ao de guerra no centro da cidade. Voce deve achar um canhao la perto." 
BO_Gap6_Goal_Text = "Skitch num Veiculo Marinho" 
BO_Gap6_Goal_Description = [ "Ache um veiculo marinho e de um skitch nele por 20 segundos sem parar." ] 
BO_Gap6_Goal_Tip = "Para dar um skitch, mire na traseira de um veiculo e aperte \\b7 pra se segurar. Lembre-se de manter o equilibrio." 
BO_Gap2_Goal_Text = "Derrubar 3 placas T" 
BO_Gap2_Goal_Description = [ "Derrubar 3 placas T" ] 
BO_Gap5_Goal_Text = "Decapitar as Est\xE1tuas" 
BO_Gap5_Goal_Description = [ "Ache um jeito de tirar a cabe\xE7a de tres est\xE1tuas." ] 
BO_Gap5_Goal_Tip = "Voce vai querer tentar um Spine Transfer (\\ml), ou um liptrick (\\b0)" 
BO_Gap12_Goal_Text = "Achar o Personagem Especial" 
BO_Gap12_Goal_Description = [ "Ache o nosso convidado e ele ajudar\xE1 a completar mais uns objetivos." ] 
BO_Gap12_Goal_Tip = "O convidado pode estar escondido em qualquer lugar. Tente procurar dentro de pr\xE9dios e nos telhados." 
JesseJames_BO_Goal_Gaps12_Camanim01 = [ "Ei, voce me achou! Quer uma ajuda? Ok! Aqui vai a minha parte." ] 
JesseJames_BO_Goal_Gaps12_Camanim02 = [ "Ja viu um skate park que pega 160 na estrada? Saca so essa beleza." ] 
JesseJames_BO_Goal_Gaps12_Camanim03 = [ "Que tal? Eu ando tentando fazer algo com essa scooter de bosta que eu montei. Deixe eu fazer alguns dos seus objetivos e eu te deixo andar na rampa." ] 
BO_TrickTheObjects_Goal_Text = "Combo dos Quatro Bancos" 
BO_TrickTheObjects_Goal_Description = [ "De um grind nos quatro bancos no mesmo combo." ] 
BO_TrickTheObjects_Goal_Tip = "Voce pode fazer grinds entre pequenos espa\xE7os." 
BO_Gaps_Goal_Text = "Achar o Ben Franklin" 
BO_Gaps_Goal_Description = [ "Um imitador do Benjamin Franklin est\xE1 escondido em Boston. Ele te ajudar\xE1 se voce encontra-lo." ] 
BO_Gaps_Goal_Tip = "Voce vai ter que entrar num predio pra acha-lo." 
BO_Gap8_Goal_Text = "Marcar seu Territorio" 
BO_Gap8_Goal_Description = [ "Um grafiteiro chamado Spat esteve deixando seu nome por toda a cidade. Cubra todas as suas tags." ] 
BO_Gap8_Goal_Tip = "Para fazer um graffiti, ande (aperte \\mm) at\xE9 uma parede e aperte \\b0." 
BO_Gap7_Goal_Text = "Dever Hospitalar" 
BO_Gap7_Goal_Description = [ "Voce precisa roubar uma maca do hospital, e levar o garoto para ver o idolo dele, Tony Hawk." ] 
BO_Gap7_Goal_Tip = "Depois de pegar a maca, cuidado com os GUARDAS." 
BO_TimedScoreRun_View_Goal_Text = "Highscore do Fliperama" 
BO_TimedScoreRun_Goal_Text = "Bata o Highscore!" 
BO_TimedScoreRun_Goal_Description = [ "Ache uma m\xE1quina de fliperama e fa\xE7a uma boa pontua\xE7ao." ] 
BO_TrickToTheBeat_View_Goal_Text = "Dan\xE7a, Otario!" 
BO_TrickToTheBeat_Goal_Text = [ "Escute!\\nFa\xE7a as manobras ao som da batida." ] 
BO_TrickToTheBeat_Goal_Description = [ "Ache a boom-box e fa\xE7a as manobras no ritmo da musica." ] 
BO_TrickToTheBeat_Goal_Tip = "Escute com cuidado. As manobras devem ser feitas no tempo certo." 
BO_RVCombo_Goal_Text = "Combo na Rampa" 
BO_RVCombo_Easy_Goal_Description = [ "Fa\xE7a um combo de 2000 pontos em cima da rampa movel." ] 
BO_RVCombo_Normal_Goal_Description = [ "Fa\xE7a um combo de 5000 pontos em cima da rampa movel." ] 
BO_RVCombo_Hard_Goal_Description = [ "Fa\xE7a um combo de 25000 pontos em cima da rampa movel." ] 
BO_RVCombo_Goal_Tip = "Para abrir a rampa movel, voce tem que completar a missao \'Pular os Carros\' com o convidado secreto do nivel." 
BO_Gap13_Goal_Text = "Saude o General" 
BO_Gap13_Goal_Description = [ "Fa\xE7a um \\t1 (\\k1) da est\xE1tua do Washington." ] 
BO_Gap13_Goal_Tip = "Para fazer um spine transfer, pule bem alto e aperte \\ml." 
BO_Gap10_Goal_Text = "Grafite o Outdoor" 
BO_Gap10_Goal_Description = [ "De seu jeito para subir nesse outdoor e fazer um graffiti l\xE1 em cima." ] 
BO_Gap10_Goal_Tip = "Tente escalar a mangueira amarela pra chegar la em cima. Aperte \\b7 para escalar enquanto voce est\xE1 andando. Enquanto anda nas plataformas, voce pode apertar \\b3 pra pular e \\bf pra se segurar nas bordas e escadas." 
BO_SkateTheLine2_Goal_Text = "Trilhos Mais Finos de Boston" 
BO_SkateTheLine2_Goal_Description = [ 
	"- Primeiro, de um grind na escultura." 
	"- Depois no trilho na frente do Jeers." 
	"- E por ultimo, no trilho do museu." 
] 
BO_SkateTheLine2_Goal_Tip = "Voce ter\xE1 tempo limitado pra dar grind nos trilhos. Para ganhar tempo, comece indo em dire\xE7ao do Jeers, onde voce da grind na escultura." 
BO_Gap9_Goal_Text = "Slap nas Placas" 
BO_Gap9_Goal_Description = [ "Fa\xE7a um sticker slap nas quatro placas de \'No Skate Boarding\'." ] 
BO_Gap9_Goal_Tip = "Para fazer um stickerslap, pule contra a parede e aperte \\b3." 
BO_FireCombo_Goal_Text = "As Grandes Bolas de Fogo" 
BO_FireCombo_Easy_Goal_Description = [ "Fa\xE7a um combo de 5000 pontos enquanto seu skate est\xE1 pegando fogo." ] 
BO_FireCombo_Normal_Goal_Description = [ "Fa\xE7a um combo de 15000 pontos enquanto seu skate est\xE1 pegando fogo." ] 
BO_FireCombo_Hard_Goal_Description = [ "Fa\xE7a um combo de 50000 pontos enquanto seu skate est\xE1 pegando fogo." ] 
BO_FireCombo_Goal_Tip = "Pule em cima do lixeiro pegando fogo pra acender seu skate." 
BO_SkateTheLine3_Goal_Text = "Andar na Liberty Trail" 
BO_SkateTheLine3_Goal_Tip = "Um vert transfer significa ir de uma rampa at\xE9 a outra no ar." 
BO_SkateTheLine3_Goal_Description = [ 
	"- Primeiro, de um \\t1 (\\k1) nas escadas da \\n  Statehouse." 
	"- Depois, fa\xE7a um vert transfer sobre o mural da biblioteca. " 
	"- E no fim, de um acid drop (\\ml) da g\xE1vea do Barco da Festa do Ch\xE1." 
] 
BO_Gap3_Goal_Text = "Tudo pelos Benjamins" 
BO_Gap3_Goal_Description = [ "Veja se voce consegue entrar no banco Riboff." ] 
BO_Gap3_Goal_Tip = "Tente entrar pelo segundo andar." 
BO_HighCombo_Goal_Text = "Combo em Alto Mar" 
BO_HighCombo_Goal_Description_Easy = [ "Fa\xE7a um combo de 3000 enquanto estiver dentro do Barco da Festa do Ch\xE1." ] 
BO_HighCombo_Goal_Description_Med = [ "Fa\xE7a um combo de 10000 enquanto estiver dentro do Barco da Festa do Ch\xE1." ] 
BO_HighCombo_Goal_Description_Hard = [ "Fa\xE7a um combo de 40000 enquanto estiver dentro do Barco da Festa do Ch\xE1." ] 
BO_Gap14_Goal_Text = "Pular os Carros" 
BO_Gap14_Goal_Description = [ "Pule sobre 3 veiculos enquanto anda com a scooter do Jesse James." ] 
BO_Gap14_Goal_Tip = "Complete esse objetivo e o Jesse vai te deixar andar na rampa movel." 
BO_SkateTheLine4_Goal_Text = "Scooter Vs. Cadeira de Rodas" 
BO_SkateTheLine4_Goal_Description = [ "Corra contra o Paulie ao redor da quadra com a scooter do Jesse. Passe pela igreja, pela biblioteca, pelo hospital e volte pra c\xE1 antes que o Paulie chegue." ] 
BO_SkateTheLine_Goal_Text = "Tour do Spine Transfer" 
BO_SkateTheLine_Goal_Description = [ 
	"- Comece com um spine transfer na entrada do metro." 
	"- Depois, fa\xE7a um spine transfer num vulcao do hospital." 
	"- E por ultimo, um spine transfer sobre a agua para entrar no \\n Barco da Festa do Ch\xE1." 
] 
BO_SkateTheLine_Goal_Tip = "Para fazer um spine transfer aperte \\ml." 
BO_Skatestoppers_Goal_Text = "Remover os Bloqueadores" 
BO_Skatestoppers_Goal_Description = "Tire todos os 4 bloqueadores de grind do trilho do ventilador." 
BO_Skatestoppers_Goal_Tip = "Tente usar algo mais forte do que um skate..." 
BA_Intro_Text1 = "Que pasa?!  Bem-vindo a Espanha!" 
BA_Intro_Text2 = "E o seguinte: com o Burnquist fora, voce vai ter que dobrar o esfor\xE7o." 
BA_Intro_Text3 = "Acho melhor come\xE7ar com um Hiroshima Snot Rocket, mas aqui vao outras coisas pra voce tentar..." 
BA_Gap8_Goal_Text = "Liberte o Toureiro" 
BA_Gap8_Goal_Description = [ "O toureiro precisa de sua ajuda! Ache um jeito de tira-lo dali." ] 
BA_Gap8_Goal_Tip = "Tente tirar o touro primeiro. Se voce deixa-lo bravo, quem sabe ele nao sai da jaula?!" 
BA_Gap13_Goal_Text = "Ache o Convidado Especial" 
BA_Gap13_Goal_Description = [ "Aquele doido do Steve-O est\xE1 escondido em algum lugar. Se voce acha-lo, ele te ajudar\xE1 a fazer mais objetivos." ] 
BA_Gap13_Goal_Tip = "Ele pode estar em um andar alto de um predio." 
BA_Gap9_Goal_Text = "Acerte 5 Pedestres com Tomates" 
BA_Gap9_Goal_Description = [ "Tente atirar tomates em 5 pedestres diferentes." ] 
BA_Gap9_Goal_Tip = "Primeiro voce precisa achar um vendedor de tomate." 
BA_TimedScoreRun_View_Goal_Text = "Highscore do Fliperama" 
BA_TimedScoreRun_Goal_Text = "Fa\xE7a um high score." 
BA_TimedScoreRun_Goal_Description = [ "Ache um fliperama e fa\xE7a uma pontua\xE7ao alta." ] 
BA_Gap3_Goal_Text = "Spine nos Canteiros do Guell" 
BA_Gap3_Goal_Description = [ "Fa\xE7a um Spine Transfer nos tres canteiros no Parc Guell." ] 
BA_Gap3_Goal_Tip = "Aperte \\ml para dar um spinetransfer." 
BA_Gap2_Goal_Text = "Ajude o Peg Leg" 
BA_Gap2_Goal_Description = [ "O barco do Peg Leg ficou preso nas redes. De um jeito de tira-lo dali." ] 
BA_Gap2_Goal_Tip = "Essas redes podem ser fortes o bastante para dar um grind." 
BA_Gap5_Goal_Text = "Marcar Seu Territorio" 
BA_Gap5_Goal_Description = [ "Spat veio ate Barcelona e deixou sua marca. Ache 5 tags dele e fa\xE7a seu desenho sobre elas." ] 
BA_Gap5_Goal_Tip = "Para deixar sua marca, v\xE1 at\xE9 a parede e aperte \\b0." 
BA_Gap7_Goal_Text = "Remova o Lixo" 
BA_Gap7_Goal_Description = [ "Ache e esvazie 4 latas de lixo." ] 
BA_Gap7_Goal_Tip = "De um grind (\\b0) para esvaziar as latas." 
BA_SkateTheLine1_Goal_Text = "Desafio do Trilho" 
BA_SkateTheLine1_Goal_Description = [ 
	"- Primeiro, de um grind nas tres correntes na frente da \\n  esta\xE7ao Estacion Sants." 
	"- Depois, de um sticker slap na placa da Jeep no \\n hospital." 
	"- Por ultimo, de um grind no trilho no topo do \\n telhado da esta\xE7ao." 
] 
BA_SkateTheLine1_Goal_Tip = "Para fazer um sticker slap, pule numa parede e aperte \\b3." 
BA_Gap15_Goal_Text = "Grab 720 na Catapulta" 
BA_Gap15_Goal_Description = [ "Fa\xE7a um grab de 720 graus depois de ser lan\xE7ado por uma catapulta." ] 
BA_Gap15_Goal_Tip = "Entre em uma das portas do lado do castelo para achar as catapultas." 
BA_Gap14_Goal_Text = "Combos em Focus" 
BA_Gap14_Goal_Tip = "Para ganhar focus, voce deve encher a barra especial e apertar (\\mq). Continue fazendo manobras pra continuar em focus." 
BA_TrickTheObjects1_Goal_Text = "Combo nos Bancos de Sants" 
BA_TrickTheObjects1_Goal_Description = [ "Na frente da esta\xE7ao Estacion Sants, h\xE1 8 bancos. De um grind nos oito em um combo." ] 
BA_TrickTheObjects1_Goal_Tip = "Voce pode dar grind em espa\xE7os pequenos." 
BA_Gap12_Goal_Text = "Transferencia na Entrada do Guell" 
BA_Gap12_Goal_Description = [ "Fa\xE7a uma transferencia de rampa pra rampa de um lado da entrada do Guell para o outro." ] 
BA_Gap12_Goal_Tip = "Se voce quiser mais velocidade, fa\xE7a um spinetransfer antes de tentar a transferencia." 
BA_Gap4_Goal_Text = "Grafite o Outdoor" 
BA_Gap4_Goal_Description = [ "De um jeito para subir no outdoor e deixar sua marca." ] 
BA_Gap4_Goal_Tip = "Pra subir nesse outdoor, tente achar uma carona ou use suas habilidades sem o skate." 
BA_Gap10_Goal_Text = "Acid Drop de um Bondinho" 
BA_Gap10_Goal_Description = [ "Pegue uma carona no bondinho e de um acid drop em uma rampa." ] 
BA_Gap10_Goal_Tip = "Para fazer um acid drop aperte \\ml quando estiver no ar e em cima de uma rampa." 
BA_Gap20_Goal_Text = "Desafio da Equipe" 
BA_Gap20_Goal_Description = [ "Quatro pessoas da sua equipe devem ser jogadas no ar pelo touro e fazer um combo de 5 mil pontos." ] 
BA_Gap20_Goal_Tip = "Voce tem que soltar o touro primeiro." 
BA_Gap6_Goal_Text = "O Trilho Espiral de La Pedrera" 
BA_Gap6_Goal_Description = [ "Comece do topo do pr\xE9dio e de de um grind por todo o trilho em espiral de La Pedrera." ] 
BA_Gap6_Goal_Tip = "Voce tem que ir at\xE9 o fim, nao esque\xE7a." 
BA_Gap11_Goal_Text = "Grab na Bosta do Touro" 
BA_Gap11_Goal_Description = [ "Seja lan\xE7ado de um monte de bosta e fa\xE7a um grab." ] 
BA_Gap11_Goal_Tip = "Siga o touro para encontrar a bosta." 
BA_Gap1_Goal_Text = "Crie-Sua-Fenix" 
BA_Gap1_Goal_Description = [ "Ache um jeito de acender seu skate, e ache um p\xE1ssaro pra fazer uma fenix." ] 
BA_Gap1_Goal_Tip = "Logo que voce acender o skate, ache algo pra atirar voce em uma revoada de p\xE1ssaros." 
BA_Gap19_Goal_Text = "Nao Toque no Chao" 
BA_Gap19_Goal_Description = [ "Va de um lado da ponte para o outro sem tocar no chao." ] 
BA_Gap19_Goal_Tip = "Os bondinhos estao fora dos limites. Grinds sao sua melhor alternativa." 
BA_Gap16_Goal_Text = "Steve-O contra o Touro" 
BA_Gap16_Goal_Description = [ "Ponha o Steve-O pra dar uma voltinha com o touro. Va perto do touro e veja quem sai vitorioso." ] 
BA_Gap16_Goal_Tip = "Pegue o maximo de velocidade possivel antes de ir pra perto do touro." 
BA_HighCombo_Goal_Text = "Combo no Guell" 
BA_HighCombo_Easy_Goal_Description = [ "Fa\xE7a um combo de 15,000 pontos andando na \xE1rea do Parc Guell." ] 
BA_HighCombo_Normal_Goal_Description = [ "Fa\xE7a um combo de 25,000 pontos andando na \xE1rea do Parc Guell." ] 
BA_HighCombo_Hard_Goal_Description = [ "Fa\xE7a um combo de 100,000 pontos andando na \xE1rea do Parc Guell." ] 
BA_Gap17_Goal_Text = "Melhores Flips de Barcelona" 
BA_Gap17_Goal_Description = [ "Barcelona \xE9 famosa por ter otimos lugares pra andar de skate. De um flip em cada um desses lugares..." 
	"- De um flip em uma mesa na \\nesta\xE7ao Estacion Sants." 
	"- De um flip da borda na frente \\n do museu." 
	"- De um flip sobre o trilho das \\n  ondas de Besos." 
] 
BA_Gap21_Goal_Text = "Impulso do Yee Haw!" 
BA_Gap21_Goal_Description = [ "Use os ventiladores no pr\xE9dio pra pegar um impulso. Fa\xE7a um \'Yee Haw!\' e de um acid drop em um QP." ] 
BA_Gap21_Goal_Tip = "Spine Transfers dao mais impulso e podem ser uteis para chegar nos ventiladores.\\n\\nQualquer grab \xE9 um \'Yee Haw!\' quando voce \xE9 o Steve-O." 
BE_Gap7_Goal_Text = "Solte os Espiritos" 
BE_Gap7_Goal_Description = [ "H\xE1 espiritos presos na igreja explodida. Ache um jeito de libertar esses espiritos." ] 
BE_Gap7_Goal_Tip = "Aquele buraco na parede deve ser tapado por um sticker." 
BE_Gap8_Goal_Text = "Ajude o Wee-Man" 
BE_Gap8_Goal_Description = [ "Ajude o Wee-Man a soltar os seus peixes favoritos do aqu\xE1rio." ] 
BE_Gap8_Goal_Tip = "Para fazer um sticker slap, pule contra a parede e aperte \\b3." 
BE_Gap9_Goal_Text = "Fa\xE7a as Crian\xE7as Pararem de Fumar" 
BE_Gap9_Goal_Description = [ "Previna as crian\xE7as de comprar cigarros. Estrague as tres m\xE1quinas de tabaco." ] 
BE_Gap9_Goal_Tip = "Para fazer um sticker slap, pule contra a parede e aperte \\b3." 
BE_Gap10_Goal_Text = "Inliners Rulam" 
BE_Gap10_Goal_Description = [ "Os inliners acham que mandam na cidade. Desmonte as duas placas de \'Inliners Rulam\', e mostre pra eles quem \xE9 que rula." ] 
BE_Gap10_Goal_Tip = "Um grind nas placas deve dar conta do recado." 
BE_Gap13_Goal_Text = "Achar o Personagem Especial" 
BE_Gap13_Goal_Description = [ "O personagem especial nessa cidade \xE9 seu companheiro...Paulie. Encontre onde ele est\xE1 e ele ajudar\xE1 com alguns objetivos." ] 
BE_Gap13_Goal_Tip = "Paulie deu um jeito pra subir em um telhado em algum lugar da cidade." 
BE_TimedScoreRun_View_Goal_Text = "Highscore do Fliperama" 
BE_TimedScoreRun_Goal_Text = "Fa\xE7a o highscore" 
BE_TimedScoreRun_Goal_Description = [ "Ache um fliperama e bata o recorde." ] 
BE_Gap_Goal_Text = "Ownando Berlin" 
BE_Gap_Goal_Description = [ "Remova algumas letras dessa placa, pra que ela diga \'OWNED!\'." ] 
BE_Gap_Goal_Tip = "Tente dar um grind no topo das letras." 
BE_Gap2_Goal_Text = "Achar o Graffiti Tagger" 
BE_Gap2_Goal_Description = [ "Ache um tagger local e ele entrar\xE1 na sua equipe." ] 
BE_Gap2_Goal_Tip = "Taggers gostam de se esconder na borda de pr\xE9dios." 
BE_Gap16_Goal_Text = "Grind N Barf" 
BE_Gap16_Goal_Description = [ "Ache os dois policiais de aluguel e de um Grind N Barf nos trilhos acima deles." ] 
BE_Gap16_Goal_Tip = "Para fazer um Grind N Barf aperte (\\b6 + \\b5 + \\b0)" 
BE_HighCombo_Goal_Text = "Combo Sagrado" 
BE_HighCombo_Easy_Goal_Description = [ "Fa\xE7a um combo de 15,000 pontos andando dentro da igreja destruida." ] 
BE_HighCombo_Normal_Goal_Description = [ "Fa\xE7a um combo de 40,000 pontos andando dentro da igreja destruida." ] 
BE_HighCombo_Hard_Goal_Description = [ "Fa\xE7a um combo de 200,000 pontos andando dentro da igreja destruida.." ] 
BE_HighCombo_Goal_Tip = "De um Spine Transfer (\\ml) pra entrar na igreja." 
BE_Gap4_Goal_Text = "Aprenda o the Natas Spin" 
BE_Gap4_Goal_Description = [ "Ache Natas Kaupas e ele te ensinar\xE1 a fazer o Natas Spin." ] 
BE_Gap5_Goal_Text = "Chap\xE9us na Brasa" 
BE_Gap5_Goal_Description = [ "Ache 3 policiais e veja se voce consegue por fogo nos tres de uma vez." ] 
BE_Gap5_Goal_Tip = "Acenda seu skate e de um ollie por cima dos policiais." 
BE_Gap3_Goal_Text = "So Focused, So Clean" 
BE_Gap3_Goal_Easy_Description = [ "Fa\xE7a 3 combos clean de 2,000 pontos enquanto estiver em focus." ] 
BE_Gap3_Goal_Normal_Description = [ "Fa\xE7a 3 combos clean de 10,000 pontos enquanto estiver em focus." ] 
BE_Gap3_Goal_Hard_Description = [ "Fa\xE7a 3 combos clean de 100,000 pontos enquanto estiver em focus." ] 
BE_Gap3_Goal_Tip = "Para entrar em focus, encha a barra especial e aperte (\\mq). Pra aterrisar \'clean\', fa\xE7a um giro de pelo menos 180 com uma aterrisagem perfeita." 
BE_SkateTheLine2_Goal_Text = "Linha dos Turistas" 
BE_SkateTheLine2_Goal_Description = [ 
	"- Primeiro, de um grind na borda do zoologico." 
	"- Depois, de um grind no cano azul." 
	"- Depois, de um grind nas barreiras." 
	"- Depois, de um grind nas escadas." 
	"- Depois, de um grind na borda." 
	"- Depois, de um sticker slap na placa azul." 
	"- Depois, de um grind na borda de novo." 
	"- No final, de um acid drop na rampa do muro." 
] 
BE_Gap15_Goal_Text = "Cause uma Interferencia" 
BE_Gap15_Goal_Description = [ 
	"- Primeiro, pule e pegue um impulso nesse ventilador" 
	"- Depois, de um ACID DROP no QP da Galeria" 
	"- Fa\xE7a um Rocket Air sobre os sat\xE9lites de uma rampa pra outra" 
] 
BE_Gap15_Goal_Tip = "Para fazer o Rocket Air aperte (\\b7 + \\b2 + \\b2)." 
BE_SkateTheLine3_Goal_Text = "Linha PRO dos Turistas" 
BE_SkateTheLine3_Goal_Description = [ 
	"- Primeiro, suba esse quarterpipe." 
	"- Depois, de um grind na borda baixa." 
	"- Depois, de um grind na borda m\xE9dia." 
	"- Depois, de um grind na borda alta." 
	"- Depois, de um grind na borda baixa da Galeria." 
	"- Depois, de um grind nos trilhos do toldo em dire\xE7ao das letras." 
	"- No final, de um lip nas letras" 
] 
BE_Gap6_Goal_Text = "Bombando Tinta" 
BE_Gap6_Goal_Description = [ "Pegue algumas latas de tinta e atire em 5 taggers rivais." ] 
BE_Gap6_Goal_Tip = "Voce pode achar latinhas na borda que voce achou o graffiti tagger." 
BE_Gap11_Goal_Text = "Marcar Seu Territorio" 
BE_Gap11_Goal_Description = [ "Spat sempre est\xE1 um passo \xE1 sua frente. Cubra todas as 5 tags." ] 
BE_Gap11_Goal_Tip = "Para pintar sua tag, aperte \\b0 quando estiver sem o skate." 
BE_Gap12_Goal_Text = "Grafite o Outdoor" 
BE_Gap12_Goal_Description = [ "Esse outdoor nao \xE9 o lugar perfeito pra deixar sua marca? Suba l\xE1 e pinte." ] 
BE_Gap12_Goal_Tip = "Para grafitar esse outdoor, segure-se no topo dele e aperte \\b0." 
BE_Gap14_Goal_Text = "Tagger Skillz" 
BE_Gap14_Goal_Description = [ 
	"Graffiti Tagger, arrombe a igreja e pinte o mural.\\nMas pinte a parede inteira." 
] 
BE_SkateTheLine1_Goal_Text = "Tour em Berlin" 
BE_SkateTheLine1_Goal_Description = [ 
	"- Primeiro, de um grind nas escadas." 
	"- Depois, de um grind no canteiro." 
	"- Depois, de um grind na borda do meio do \\n  pr\xE9dio dourado." 
	"- Depois, de um grind na borda da placa." 
	"- No final, de um grind no topo da fonte." 
] 
BE_HighCombo2_Goal_Text = "Combo Sobre Rodas" 
BE_HighCombo2_Easy_Goal_Description = [ "Fa\xE7a um combo de 5,000 pontos com Paulie na cadeira de rodas." ] 
BE_HighCombo2_Normal_Goal_Description = [ "Fa\xE7a um combo de 15,000 pontos com Paulie na cadeira de rodas." ] 
BE_HighCombo2_Hard_Goal_Description = [ "Fa\xE7a um combo de 125,000 pontos com Paulie na cadeira de rodas." ] 
BE_HighCombo2_Goal_Tip = "Paulie pode dar grinds, manual, reverts, tudo o que voce faz no skate." 
BE_Gap19_Goal_Text = "Habilidade nas Rodas" 
BE_Gap19_Goal_Description = "Pule da rampa com o Paulie e fa\xE7a um Sit Flip (\\b5 + \\b1) e de um Acid Drop na rampa." 
BE_Gap20_Goal_Text = "Desafio da Equipe" 
BE_Gap20_Goal_Description = [ 
	"- Bam precisa fazer manual dos primeiros dois cones \\n at\xE9 os outros dois." 
	"- Paulie precisa dar grind em circulos por 10\\n  segundos." 
	"- Voce precisa dar um a\xE9reo de 5,000 pontos dentro\\n  da igreja destruida." 
] 
AU_Intro_Text1 = "Cara, a Tailandia foi foda! Agora nos podemos ownar a Australia por que a equipe do Bam perdeu o voo de Bangkok." 
AU_Intro_Text2 = "Eles desmaiaram num barco e acabaram na India! Voce precisa come\xE7ar a fazer uns objetivos..." 
AU_Elimination_Text1 = "Ha Ha!  Ae, consegui.  Beleza.  Bora, galera, agora o que?" 
AU_Elimination_Text2 = "Roubou as roupas dele? Esse foi seu grande truque? Tu \xE9 um idiota, por que tu t\xE1 ainda no meu time? Me d\xE1 isso aqui, eu tive uma ideia." 
AU_Elimination_Text3 = "Beleza, com essas roupas e essa m\xE1scara, voce ficou igualzinho ao Beaverhausen.  Agora va encher o saco de alguns australianos, eles cuidarao do resto." 
AU_TSR_Text = "Highscore do Fliperama" 
AU_TSR_Desc = [ "Ache um fliperama a fa\xE7a o highscore." ] 
AU_TTO_Text = "Combo de Grind nos Corrimaos" 
AU_TTO_Desc_Easy = [ "De um grind nos tres corrimaos e fa\xE7a 25,000 pontos em um combo." ] 
AU_TTO_Desc_Med = [ "De um grind nos tres corrimaos e fa\xE7a 50,000 pontos em um combo." ] 
AU_TTO_Desc_Hard = [ "De um grind nos tres corrimaos e fa\xE7a 300,000 pontos em um combo." ] 
AU_Mini_Text = "Liptrick no Mini" 
AU_Mini_Desc_Easy = [ "Fa\xE7a um combo de 5,000 na miniramp. O combo deve conter um lip trick." ] 
AU_Mini_Desc_Med = [ "Fa\xE7a um combo de 15,000 na miniramp. O combo deve conter um lip trick." ] 
AU_Mini_Desc_Hard = [ "Fa\xE7a um combo de 175,000 na miniramp. O combo deve conter um lip trick." ] 
AU_Mini_Tip = "E mais f\xE1cil se voce fizer a liptrick por primeiro ou por ultimo. Aperte duas vezes \\b0, \\b1 ou \\b2 em um liptrick para fazer varia\xE7oes." 
AU_Crane_Text = "Acordar a Bela Adormecida" 
AU_Crane_Desc = [ "De um jeito de acordar o operador do guindaste." ] 
AU_Crane_Tip = "Voce aprendeu a dar Natas Spin? Pra dar um Natas Spin aperte \\bf+\\b0." 
AU_Aborigine_Text = "Achar o Personagem Especial" 
AU_Aborigine_Desc = [ "O nativo curte andar de kart! Ache-o e veja se ele te deixa dar uma voltinha." ] 
AU_Aborigine_Tip = "Voce achar\xE1 o cara depois de ter feito algumas demoli\xE7oes." 
AU_TidePool_Text = "Drenar a Piscina" 
AU_TidePool_Desc = [ "De um jeito de drenar a piscina para sua equipe andar l\xE1." ] 
AU_TidePool_Tip = "Bombas el\xE9tricas vivem quebrando." 
AU_Meal_Text = "Acabe com Uma Refei\xE7ao, ou Seis" 
AU_Meal_Desc = [ "Ache um lugar onde as pessoas estao comendo e veja se voce consegue fazer a comida voar." ] 
AU_Shrimp_Text = "Achar o Vendedor de Camarao" 
AU_Shrimp_Desc = [ "Ache o vendedor ambulante de camarao e fa\xE7a ele entrar na sua equipe." ] 
AU_2Cars_Text = "Focus em um Flip Duplo e Clean" 
AU_2Cars_Desc = [ "Pegue Focus, e aterrise um 180 double kickflip clean sobre dois carros estacionados." ] 
AU_2Cars_Tip = "Para pegar focus, encha a barra especial e aperte (\\mq). Para fazer \'clean\', fa\xE7a um giro de pelo menos 180 com aterrisagem perfeita." 
AU_Bigguns_Text = "Todo Mundo Adora Bigguns" 
AU_Bigguns_Desc = [ "Ache e fa\xE7a a transferencia de rampa Bigguns." ] 
AU_Bigguns_Tip = "Do topo at\xE9 o fundo, nao o meio." 
AU_BridgeMan_Text = "Equilibre-se ao Alto e Al\xE9m" 
AU_BridgeMan_Desc = [ "Fa\xE7a um manual da base da passarela, subindo e indo at\xE9 o outro lado (em qualquer dire\xE7ao)." ] 
AU_BridgeMan_Tip = "Encha sua barra especial e chegue na passarela com bastante velocidade." 
AU_KnyFngr_Text = "Os Sentimentos do Kenny" 
AU_KnyFngr_Desc = [ "Depois de anos de trabalho dedicado como mascote do zoologico, Kenny ganhou uma est\xE1tua. Fa\xE7a um Natas Spin nos seus dedos para ver como ele realmente se sente." ] 
AU_KnyFngr_Tip = "Para dar um Natas aperte \\bf +\\b0." 
AU_Acid_Text = "Pulando sem Paraquedas" 
AU_Acid_Desc = [ "Suba at\xE9 a sacada mais alta da cidade e fa\xE7a um acid drop na piscina la embaixo." ] 
AU_Acid_Tip = "Aperte \\ml no ar em cima de uma rampa para dar um Acid Drop." 
AU_Graf_Text = "Grafite o Outdoor" 
AU_Graf_Desc = [ "Os vegetarianos locais estao bravos com essa propaganda, e ela, por sorte, est\xE1 em um local privilegiado. De um jeito pra subir l\xE1 a deixar sua marca." ] 
AU_Trash_Text = "Hank Ca\xE7a-tesouros" 
AU_Trash_Desc = [ "Hank Ca\xE7a-tesouros precisa da sua ajuda. O nosso colega do detector de metal t\xE1 ai todo fim de semana tentando achar algo que fa\xE7a o aparelho fazer \'bip\'. Veja se voce consegue achar algumas latas pra ele." ] 
AU_Team_Text = "Desafio da Equipe" 
AU_Team_Desc = [ "Tres skaters...e um toldo. Voce, seu amigo pro, e o vendedor de camarao, tem que dar um grind no toldo do TC. E um pouco mais dificil de grindar do que parece..." ] 
AU_Stairs_Text = "Machos de Verdade Fazem Flips" 
AU_Stairs_Desc = [ "Pegue Focus, e fa\xE7a um Double Heelflip clean de 360 graus na escadaria." ] 
AU_Stairs_Tip = "Para pegar focus, encha sua barra especial e aperte (\\mq). Para fazer clean, de pelo menos um giro de 180 com uma aterrisagem perfeita." 
AU_Lofty_Text = "Rolando, Rolando, Rolando...\'" 
AU_Lofty_Desc = [ "Pegue especial e fa\xE7a dois Rotissierres sobre o Lofty Roof Gap entre os dois pr\xE9dios do centro." ] 
AU_Lofty_Tip = "Pegue a linha do teto desde o primeiro pr\xE9dio e pegue impulso para pegar o gap sobre o pr\xE9dio de tijolos." 
AU_Slap_Text = "Toma Isso!" 
AU_Slap_Desc = [ "Ningu\xE9m est\xE1 nadando por causa dos tubaroes, e os salva vidas estao entediados. De a eles algo pra fazer, acertando eles com camaroes frios e gosmentos." ] 
AU_Slap_Tip = "Acerte cinco salvavidas DIFERENTES." 
AU_Gulls_Text = "O Espanta-Gaivotas" 
AU_Gulls_Desc = [ "Gaivotas nao sao nada mais que sacos de bosta com asas...e sua camisa e cabelo provaram isso v\xE1rias vezes. Espante 10 gaivotas com um combo so." ] 
AU_Signs_Text = "Caos para os Deficientes" 
AU_Signs_Desc = [ "Use o kart para derrubar 5 placas de estacionamento para deficientes que estao no meio das suas linhas." ] 
AU_SecCombo_Text = "Combo No Paraiso" 
AU_SecCombo_Desc = [ "Agora que voce encontrou esse lindo paraiso...ANDE DE SKATE! De um grind em todas as pedras da borda em um combo so." ] 
AU_KnyHd_Text = "Ajude os Skatistas Locais" 
AU_KnyHd_Desc = [ "Esse oficial est\xE1 com dois skatistas locais sob custodia. Veja se voce consegue distrai-lo enquanto eles fogem." ] 
AU_KnyHd_Tip = "Aquele guindaste funcionava bem, antes...." 
AU_540_Text = "Lan\xE7amento do Kart" 
AU_540_Desc = [ "Pegue um pouco de velocidade no kart e de um 540 na Footbridge Flyover Gap." ] 
AU_Construction_text = "Encha o Saco dos Pedreiros" 
AU_Construction_Desc = [ "Vista-se como o Nigel e de um Beaver Blast em 5 pedreiros" ] 
AU_Bikini_text = "Encha o Saco das Garotas" 
AU_Bikini_Desc = [ "De um grind no fio acima das garotas de biquini" ] 
NO_Intro_Text1 = "Mais uma cidade, mais uma festa. E nenhuma festa \xE9 maior que o Mardi Gras. Bebados, idiotas, e bebados idiotas." 
NO_Intro_Text2 = "Estamos falando da maior conven\xE7ao de estupidos. Se voce quer aparecer aqui, tente esses stunts." 
NO_Equalizer_Intro_Text1 = "O Equalizador \xE9 um stunt fodao para uma equipe inteira. Voce faz ele, e estamos empatados." 
NO_Equalizer_Intro_Text2 = "Cara, o Equalizador vai ser do caralho! Eu e os caras vamos subir e pegar um helicoptero emprestado." 
NO_Equalizer_Intro_Text3 = "Venha com nos, e quando decolarmos, segure-se e fa\xE7a algumas manobras." 
NO_Equalizer_Intro_Text4 = "Ah \xE9, a seguran\xE7a vai ser pesada, entao cuidado. Vam\'bora!" 
NO_TimedScoreRun_View_Goal_Text = "Highscore do Fliperama" 
NO_TimedScoreRun_Goal_Text = "Fa\xE7a o high score" 
NO_TimedScoreRun_Goal_Description = [ "Nao \xE9 possivel que depois de todos esses levels voce ainda nao saiba!" ] 
NO_TrickToTheBeat_View_Goal_Text = "Dance, Dance, Dance" 
NO_TrickToTheBeat_View_Goal_Description = [ "Ache o boom box e fa\xE7a as manobras no ritmo." ] 
NO_TrickToTheBeat_Goal_Text = [ "Escute!\\nFa\xE7a as manobras no ritmo." ] 
NO_TrickToTheBeat_View_Goal_Tip = "Escute com cuidado. As manobras devem ser feitas na batida." 
NO_BoatSlapper_View_Goal_Text = "Slap no Barco" 
NO_BoatSlapper_View_Goal_Description = [ "Coloque 3 stickers no barco." ] 
NO_BoatSlapper_View_Goal_Tip = "Para fazer um sticker slap, pule na parede e aperte \\b3." 
NO_FindJester_View_Goal_Text = "Ache o Jester" 
NO_FindJester_View_Goal_Description = [ "Ache o rei do Mardi Gras. Ele deve estar andando em algum lugar da cidade." ] 
NO_SpatTags_View_Goal_Text = "Marcar Seu Territorio" 
NO_SpatTags_View_Goal_Description = [ "Mais uma vez, Spat deixou tags por toda Nawlins. Ache as 5 tags e deixe a sua no lugar." ] 
NO_WaterTower_View_Goal_Text = "Slap na Torre" 
NO_WaterTower_View_Goal_Description = [ "De um jeito de dar um sticker slap na torre de \xE1gua." ] 
NO_RaiseTheDead_View_Goal_Text = "Acorde os Mortos" 
NO_RaiseTheDead_View_Goal_Description = [ "Acorde os mortos-vivos abrindo as 5 criptas no cemit\xE9rio." ] 
NO_RaiseTheDead_View_Goal_Tip = "Derrube as caveiras!" 
NO_SaveNawlins_View_Goal_Text = "Salve Nawlins" 
NO_SaveNawlins_View_Goal_Description = [ 
	"- Primeiro, de um spinetransfer (\\ml) no \\n  submundo de Nawlins." 
	"- Depois, de um grind no anel do submundo. E pule fora." 
	"- Por ultimo, de um \\t1 (k1)\\n por cima da est\xE1tua da igreja." 
] 
NO_SaveNawlins_View_Goal_Tip = "Para salvar Nawlins, voce deve primeiro fazer o objetivo \'Acorde os Mortos\'." 
NO_BigBillboard_View_Goal_Text = "Grafite o Outdoor" 
NO_BigBillboard_View_Goal_Description = [ "De um jeito de subir naquela borda e pintar sua tag na placa do Mardi Gras." ] 
NO_WallieTrolley_View_Goal_Text = "Wallie no Trem" 
NO_WallieTrolley_Description = [ "De um Wallie no trem perto do rio." ] 
NO_WallieTrolley_Tip = "Para dar um Wallie, pule no trem em um angulo e aperte \\b0 para dar um wallride, entao aperte \\b3 para dar um wallie." 
NO_SpineTingler_View_Goal_Text = "Combo de Spine Transfer" 
NO_SpineTingler_Description = [ 
	"- Primeiro, de um spinetransfer (\\ml) do heliponto para a rua." 
	"- Depois, de um spine (\\ml) para a piscina no \\n  telhado do bar." 
	"- Por ultimo, de um spine (\\ml) no bar." 
] 
NO_StreetTransfer_View_Goal_Text = "Spine na Rua Nawlins" 
NO_StreetTransfer_Description = [ "De um Spine transfer (\\ml) sobre a rua Nawlins, indo de um telhado para o outro." ] 
NO_ManholeManual_View_Goal_Text = "Manual nas Bocas-de-lobo" 
NO_ManholeManual_Description = [ "De um manual sobre as 5 pequenas bocas-de-lobo em um combo." ] 
NO_SmackBirds_View_Goal_Text = "Para os P\xE1ssaros" 
NO_SmackBirds_Description = [ "Pule no ar e de uma paulada nos p\xE1ssaros." ] 
NO_SmackBirds_View_Goal_Tip = "Tente fazer um spinetransfer (\\ml) do telhado." 
NO_GasLamps_View_Goal_Text = "Distrito das Lampadas a Gas" 
NO_GasLamps_Description = [ "De um grind nas 3 lampadas a gas perto do rio." ] 
NO_BigFocus_View_Goal_Text = "Grande e com Focus" 
NO_BigFocus_View_Goal_Tip = "Para pegar focus, encha sua barra especial e aperte (\\mq)." 
NO_BigFocus_Easy_Description = [ "Entre em focus e fa\xE7a um combo de 40,000 pontos." ] 
NO_BigFocus_Normal_Description = [ "Entre em focus e fa\xE7a um combo de 100,000 pontos." ] 
NO_BigFocus_Hard_Description = [ "Entre em focus e fa\xE7a um combo de 500,000 pontos." ] 
NO_GirlsGoneCrazy_View_Goal_Text = "Parada das Garotas" 
NO_GirlsGoneCrazy_Description = [ "Entre no carro alegorico e jogue colares para 5 garotas." ] 
NO_AcidHurricane_View_Goal_Text = "Caindo de Boca" 
NO_AcidHurricane_Description = [ "De um acid drop (\\ml) no maior drink do mundo." ] 
NO_BalconyBreaker_View_Goal_Text = "Quebrando a Banca" 
NO_BalconyBreaker_Description = [ "Quebre tres sacadas pela cidade em um combo." ] 
NO_BalconyBreaker_Tip = "Para quebrar as sacadas, va de baixo para cima. Ha varios niveis de sacadas em alguns predios. Tente usar wallrides (segure \\b0 quando pular contra a parede em um angulo)." 
NO_TeamChallenge_View_Goal_Text = "Desafio da Equipe" 
NO_TeamChallenge_Description = [ "3 membros da equipe devem fazer uma manobra especial dentro do jardim da igreja." ] 
NO_ZombieHunter_View_Goal_Text = "Triciclo vs. Zumbi" 
NO_ZombieHunter_Description = [ "Mate 10 desses zumbis antes que eles tomem conta da cidade." ] 
NO_ZombieHunter_Tip = "Nenhum skater mortal pode matar zumbis. Voce precisa de alguem com uma magia. Se voce nao ve nenhum zumbi, entao ACORDE OS MORTOS!" 
NO_Trashman_View_Goal_Text = "Super Lixo" 
NO_TrashMan_Description = [ "Pegue o triciclo e fa\xE7a um Superman Seatgrab (\\b2) sobre o lixo." ] 
NO_TrashMan_Tip = "Voce vai precisar de uma boa velocidade antes de pular." 
NO_NatasNeversoft_View_Goal_Text = "Natas da Neversoft" 
NO_NatasNeversoft_Description = "De um Natas Spin sobre o olho da Neversoft na cerca do cemit\xE9rio por 10 segundos." 
NO_NatasNeversoft_Tip = "Para dar um Natas, pule num poste ou hidrante e aperte \\bf + \\b0." 
NO_SignSpinner_View_Goal_Text = "Girando as Placas" 
NO_SignSpinnder_Description = [ "Gire 3 placas fazendo grinds contra elas." ] 
ST_Intro_Text1 = "Deixamos o melhor para o final... Skatopia. A Mecca do skate." 
ST_Intro_Text2 = "Andamos ao redor do mundo, invadimos os quatro continentes...e deixamos muitas pessoas putas da vida." 
ST_Intro_Text3 = "Essa \xE9 nossa ultima chance pra ganhar essa merda, entao vam\'bora ganhar no estilo Hall da Fama!!" 
ST_Arcade_View_Goal_Text = "Highscore do Fliperama" 
ST_Arcade_Description = [ "Ache um fliperama e fa\xE7a o highscore." ] 
ST_Chainsaw_View_Goal_Text = "Ache a Serra El\xE9trica" 
ST_Chainsaw_Description = [ "Jesse James vai te construir um skate a gasolina para andar nessas montanhas, mas ele precisa de um motor. V\xE1 achar uma serra el\xE9trica." ] 
ST_BigFoot_View_Goal_Text = "A Lenda do P\xE9-grande" 
ST_BigFoot_Description = [ "Alguns dizem que \xE9 so uma lenda. Os nativos dizem j\xE1 ter visto ele." ] 
ST_ZipDrop_View_Goal_Text = "Acid Drop do cabo" 
ST_ZipDrop_Description = [ "Pegue uma carona no cabo na face do morro, e de um Acid drop (\\ml) na parte nao terminada da \xE1rea do onibus escolar." ] 
ST_BigFireworks_View_Goal_Text = "Lance os Fogos" 
ST_BigFireworks_Description = [ "Ponha fogo no seu skate e acenda os fogos de artificio." ] 
ST_HittheKite_View_Goal_Text = "Pule no Balao Meteorologico" 
ST_HittheKite_Description = [ "Ache uma rampa de madeira no topo da montanha para pular no balao meteorologico." ] 
ST_Masterpiece_View_Goal_Text = "Grafite o Outdoor" 
ST_Masterpiece_Description = [ "Voce consegue fazer uma obra-prima na face da montanha? Suba na borda, mas nao caia." ] 
ST_Tags_View_Goal_Text = "Marcar seu Territorio" 
ST_Tags_Description = [ "Quem esse corno do Spat pensa que \xE9 deixando tags por toda Skatopia? Ache 5 tags do Spat e deixe a sua tag por cima." ] 
ST_Guest_View_Goal_Text = "Ache Ryan Sheckler" 
ST_Guest_Description = [ "Ryan \xE9 um dos pros mais jovens, mas isso nao impede-o de ser um dos melhores. Ache-o e ele o ajudar\xE1 a completar alguns objetivos." ] 
ST_TreeBomb_View_Goal_Text = "Spin e Drop da Arvore" 
ST_TreeBomb_Description = [ "Fa\xE7a um Natas Spin no topo de uma \xE1rvore, e pule e de um Acid Drop." ] 
ST_TreeBomb_View_Goal_Tip = "Para dar um Natas Spin, aperte \\bf + \\b0. Para dar um Acid Drop aperte (\\ml)." 
ST_HugeManual_View_Goal_Text = "Manual do Topo da Montanha" 
ST_HugeManual_Description = [ "Fa\xE7a UM manual come\xE7ando da area do onibus no topo da montanha, e va at\xE9 o portao de entrada." ] 
ST_TrickTheLogs_View_Goal_Text = "Combo do Lenhador" 
ST_TrickTheLogs_Description = [ "De um grind em 3 troncos em um combo." ] 
ST_MineSpine_View_Goal_Text = "Spine na Mina" 
ST_MineSpine_Description = [ "De um spinetransfer na entrada da mina." ] 
ST_WallridetheFace_View_Goal_Text = "Combo do Wallride no Morro" 
ST_WallridetheFace_Description = [ "Fa\xE7a um combo de 50,000 pontos que inclua um wallride nessa face do morro." ] 
ST_SpineSeries1_View_Goal_Text = "Combo de Spine da Skatopia" 
ST_SpineSeries1_Description = [ 
	"- Primeiro, de um spinetransfer da borda do morro\\n  para a estrada abaixo." 
	"- Depois, de um spinetransfer na garagem." 
	"- Por ultimo, de um spinetransfer para o outro lado da garagem." 
] 
ST_SpineSeries1_View_Goal_Tip = "Nao caia! xD" 
ST_DownhillGrindCombo_View_Goal_Text = "Linha Downhill" 
ST_DownhillGrindCombo_Description = [ "Essa \xE9 uma linha que come\xE7a do topo da Skatopia e vai at\xE9 o fim. E so para os melhores skaters. Veja se voce consegue pegar essa linha em um combo." ] 
ST_Hives_View_Goal_Text = "Arranque as Colmeias" 
ST_Hives_Description = [ "Arranque as colmeias de abelha das paredes usando wallrides." ] 
ST_HugeElecWire_View_Goal_Text = "O Grande Fio El\xE9trico" 
ST_HugeElecWire_Description = [ "Veja se voce consegue dar um grind do fio el\xE9trico do come\xE7o at\xE9 o fim." ] 
ST_ShackCombo_View_Goal_Text = "Ataque da Cabana" 
ST_ShackCombo_Description = [ "Aqui vai um desafio. Comece um combo e entre em uma das duas cabanas. Continue o combo e entre na outra cabana. Nao ande ou voce ser\xE1 desqualificado!" ] 
ST_JumptheHouse_View_Goal_Text = "Por Cima da Casa" 
ST_JumptheHouse_Description = [ "De um spinetransfer ou um acid drop da na face da colina para ganhar velocidade. Depois, use as rampas para pular por cima da casa." ] 
ST_ZiplineDrop_View_Goal_Text = "Bomba do Fio" 
ST_ZiplineDrop_Description = [ "Em um combo, fa\xE7a um grind nesse fio e de um acid drop (\\ml) nas rampas abaixo." ] 
ST_SignTransfer_View_Goal_Text = "Transferencia da Skatopia" 
ST_SignTransfer_Description = [ "Fa\xE7a uma transferencia de rampa a rampa sobre o portao de entrada." ] 
ST_BigTRICK_View_Goal_Text = "Cres\xE7a Algumas Plantas" 
ST_BigTRICK_Description = [ "Use o poder verde do P\xE9 Grande para fazer as plantas crescerem." ] 
ST_BigRampManual_View_Goal_Text = "Caminho Limpo" 
ST_BigRampManual_Description = [ "O P\xE9 Grande limpou o caminho nessa descida. De um manual para baixo e pegue bastante velocidade e pule aquele peda\xE7o de madeira." ] 
ST_BigManual_View_Goal_Text = "Manual Ladeira Acima" 
ST_BigManual_Description = [ "Usando o skate motorizado, suba a ladeira em um manual." ] 
ST_SpinBomb_View_Goal_Text = "Spin Bomb" 
ST_SpinBomb_Description = [ "De um grind na Spin Bomb 4 vezes para ativa-la." ] 
ST_Rockets_View_Goal_Text = "Bateria de Foguete" 
ST_Rockets_Easy_Description = [ "Use o Natas Spin para ativar." ] 
ST_Rockets_Description = [ "Fa\xE7a 4 Natas Spins seguidos para ativar." ] 
ST_Fountain_View_Goal_Text = "Fonte de Gloria" 
ST_Fountain_Description = [ "De um grind em um estopim para ativar." ] 
ST_Boxbombs_View_Goal_Text = "Bombas de Caixa" 
ST_Boxbombs_Description_easy = [ "Pule em todas as bombas." ] 
ST_Boxbombs_Description = [ "Acerte 8 Caixas em 2 combos." ] 
ST_TopBomb_View_Goal_Text = "Bomba Gigante" 
ST_TopBomb_Description = [ "Suba no topo da Bomba Gigante para ativar." ] 
ST_Critter_View_Goal_Text = "Evacue os Cachorros" 
ST_Critter_Description = [ "Quando o tempo chegar a zero, as bombas irao explodir. Salve-se, resgatando o maior numero de cachorros que conseguir." ] 
ST_Escape_View_Goal_Text = "Rota de Fuga" 
ST_Escape_Description = [ "Fa\xE7a um combo at\xE9 a placa da Skatopia." ] 

