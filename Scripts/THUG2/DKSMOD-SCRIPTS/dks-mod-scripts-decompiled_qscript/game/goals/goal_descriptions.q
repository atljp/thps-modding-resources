[ 
	"Ei! Bom trabalho. Va falar com o Bob pra aprender algumas manobras de vert." 
] 
Burnquist_tr_goal_gaps4 = 
[ 
	"Primeiro, de um lip trick no QP. Para dar um lip, va reto pra ponta do QP e de um grind (\\b0) no topo." 
] 
Burnquist_tr_goal_gaps8 = 
[ 
	"Agora faca um grind no topo do QP. \\nSuba com um angulo, e aperte grind (\\b0) no topo." 
] 
Burnquist_TR_Goal_Counter4 = 
[ 
	"Ok, quando estiver no ar faca um Melon.\\n(\\b6 + \\b2)" 
] 
Burnquist_TR_Goal_Counter2 = 
[ 
	"Tente fazer uma manobra com um giro de 360. \\n(segure \\n\\b6 ou \\b5)" 
] 
Burnquist_tr_goal_gaps10 = 
[ 
	"Se voce quiser sair de um half ou QP, apenas pegue velocidade e de um Level Out (\\ml)." 
] 
Burnquist_tr_goal_gaps9 = 
[ 
	"Ja que voce ta pegando o jeito, vamos deixar um pouco mais dificil.\\n Pule de um QP para o outro.\\n Va ate o primeiro QP em um angulo e de Ollie (\\b3) para transferir para o outro lado." 
] 
Muska_tr_goal_counter3 = 
[ 
	"E ae! Surpreso em me encontrar? Por que nao aprendemos alguns Stickerslaps?" 
] 
